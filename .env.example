# SerpApi (all six signal calls)
SERPAPI_API_KEY=

# Supabase (service role key is used server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API: headline and two actions only
ANTHROPIC_API_KEY=

# Protects /api/cron (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Optional: SerpApi kgmid per league, comma separated  name:kgmid
# Find them once: engine=google, q=<league name>, read sports_results
LEAGUE_KGMIDS=ICC:/m/021q23,ISL:/m/0ynr_sq

# Optional: used to phrase the headline/actions and classify news. Anthropic wins if both are set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: evening push (Web Push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
